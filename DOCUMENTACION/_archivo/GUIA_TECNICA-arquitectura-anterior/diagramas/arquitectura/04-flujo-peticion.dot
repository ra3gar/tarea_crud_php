// Diagrama 4 - Flujo de una peticion HTTP de principio a fin
digraph flujo {
  rankdir=TB; bgcolor="white";
  graph [fontname="Helvetica", fontsize=11, ranksep=0.33];
  node  [fontname="Helvetica", fontsize=9, shape=box, style="rounded,filled", fillcolor="#ffffff", color="#c9d1da", width=3.6];
  edge  [fontname="Helvetica", fontsize=8, color="#5a6b86"];

  n1  [label="1. El navegador pide  /index.php/productos", fillcolor="#eef2f8", color="#2f5fe0"];
  n2  [label="2. Apache sirve public/ y entrega a index.php"];
  n3  [label="3. session_start()"];
  n4  [label="4. require autoload.php  +  helpers.php"];
  n5  [label="5. new Router()  y  routes/web.php le carga la tabla"];
  n6  [label="6. $_SERVER['PATH_INFO']  ->  /productos"];
  n7  [label="7. Router::despachar() compara metodo + patron\n{id} se traduce a (\\d+)"];
  d1  [label="Coincide alguna ruta?", shape=diamond, fillcolor="#fdf7ef", color="#9a6212", width=2.4, height=1.0];
  e404 [label="http_response_code(404)\n'Pagina no encontrada'", fillcolor="#fdf0f0", color="#b23b3b"];
  d2  [label="La ruta es privada?", shape=diamond, fillcolor="#fdf7ef", color="#9a6212", width=2.4, height=1.0];
  n8  [label="8. Auth::proteger()  —  hay $_SESSION['usuario_id']?", fillcolor="#fdf0f0", color="#b23b3b"];
  elog [label="Redirige a /login", fillcolor="#fdf0f0", color="#b23b3b"];
  n9  [label="9. new Controlador()  ->  metodo(...$coincidencias)\n(UsuarioController corre Admin::proteger() en su constructor)", fillcolor="#eef2f8", color="#2f5fe0"];
  n10 [label="10. El controlador lee $_GET / $_POST y valida"];
  n11 [label="11. El Modelo prepara y ejecuta el SQL", fillcolor="#f4f9f6", color="#157f52"];
  n12 [label="12. MySQL devuelve filas", shape=cylinder, fillcolor="#f4f9f6", color="#157f52"];
  n13 [label="13. Controller::vista()  ->  extract($datos) + require de la Vista", fillcolor="#fdf7ef", color="#9a6212"];
  n14 [label="14. La Vista arma el HTML y escapa todo con e()", fillcolor="#fdf7ef", color="#9a6212"];
  n15 [label="15. El navegador recibe y pinta la pagina", fillcolor="#eef2f8", color="#2f5fe0"];

  n1->n2->n3->n4->n5->n6->n7->d1;
  d1->e404 [label="no"];
  d1->d2  [label="si"];
  d2->n8  [label="si"];
  d2->n9  [label="no (ruta publica)"];
  n8->elog [label="sin sesion"];
  n8->n9   [label="con sesion"];
  n9->n10->n11->n12->n13->n14->n15;
}
