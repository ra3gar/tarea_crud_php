# Copia este archivo como .env y pone tu propia clave local para MySQL.
#   cp .env.example .env
# El mismo valor lo usan la base (usuario root) y la app. NO se sube a git.
# Si cambias esta clave DESPUES de haber levantado el proyecto, tenes que
# borrar el volumen para que tome la nueva: docker compose down -v
DB_PASS=pon_una_clave_local
