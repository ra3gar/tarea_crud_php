# =====================================================================
#  public/.htaccess — Mejora OPCIONAL de las direcciones (URLs limpias).
#
#  Si el servidor tiene activado mod_rewrite, saca el "index.php" del medio
#  de las direcciones (de /index.php/productos pasa a /productos). Si NO lo
#  tiene, todo este bloque se ignora y el sitio funciona igual (las
#  direcciones solo llevan el index.php). Por eso va dentro de <IfModule>:
#  nunca rompe nada.
#
#  Nota: en un .htaccess los comentarios van en su PROPIA linea (empezando
#  con #). No se pueden poner al final de una linea de directiva.
# =====================================================================
<IfModule mod_rewrite.c>
  # Activa el motor de reescritura de URLs.
  RewriteEngine On

  # Si lo que se pide NO es un archivo real...
  RewriteCond %{REQUEST_FILENAME} !-f
  # ...y TAMPOCO es una carpeta real...
  RewriteCond %{REQUEST_FILENAME} !-d
  # ...entonces mandalo al front controller (index.php). [L] = ultima regla.
  RewriteRule ^(.*)$ index.php/$1 [L]
</IfModule>
